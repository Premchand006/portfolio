# ─── AI assistant in the Omnibar "Ask" tab (server-side) ────────────
# Server-only Gemini key for /api/assistant.
# Free tier: ~1500 requests/day on gemini-2.5-flash.
# Get a free key (no card needed): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Contact form (Resend + Cloudflare Turnstile) ───────────────────
# Required for /api/contact to send email in production. Without these
# the form falls back to mailto: in dev and shows a friendly error in prod.
#
# Resend — https://resend.com (free 3k emails/mo)
RESEND_API_KEY=re_xxx
RESEND_FROM=portfolio@premchand.dev
RESEND_TO=korukonda.lkmpremchand@gmail.com

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# (free, unlimited, no quota). Site key is public; secret stays server-side.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
